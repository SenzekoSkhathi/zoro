# Copy this file to .env and fill in real values. Never commit .env.

# --- Azure OpenAI / Azure AI Foundry (gpt-6-sol) ---
AZURE_OPENAI_ENDPOINT=https://sa-higher-ed-research-resource.cognitiveservices.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-6-sol
AZURE_OPENAI_API_KEY=
OPENAI_API_VERSION=2024-10-21
AZURE_SPEECH_REGION=eastus2
AZURE_SPEECH_VOICE=en-GB-SoniaNeural

# --- Claude (fallback brain; also vision + computer-use) ---
ANTHROPIC_API_KEY=

# --- Deepgram (speech-to-text AND text-to-speech / Aura) ---
# Required: the agent uses Deepgram for both STT and TTS.
DEEPGRAM_API_KEY=

# --- LiveKit (realtime transport) — cloud.livekit.io ---
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Azure PostgreSQL (baseform-pg-za) ---
AZURE_POSTGRES_URL=postgresql://baseformadmin:<password>@baseform-pg-za.postgres.database.azure.com:5432/baseform?sslmode=require

# --- Azure Redis Enterprise & Application Insights ---
REDIS_URL=rediss://default:<password>@baseform-redis-za.southafricanorth.redisenterprise.cache.azure.net:10000
APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=...;IngestionEndpoint=...

# --- Supabase (legacy fallback memory) ---
# Required by src/zoro_memory.py — memory load fails without it.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# --- Tavily (web search) — tavily.com ---
# Required by src/zoro_tools.py search_web.
TAVILY_API_KEY=

# --- Google OAuth (one-time Calendar/Gmail sign-in via workspace-mcp) ---
# Used during the initial browser authorisation; tokens are then cached
# under ~/.google_workspace_mcp/ and reused by src/zoro_google.py.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- Spotify OAuth (one-time sign-in via scripts/zoro_spotify_auth.py) ---
# Register an app at https://developer.spotify.com/dashboard with redirect
# URI http://127.0.0.1:8888/callback. Tokens cache under ~/.zoro_spotify/.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# --- Claude Code CLI (long-lived OAuth token) ---
# Generate via `claude setup-token` after `npm i -g @anthropic-ai/claude-code`.
# Read by zoro_claude_code when Zoro shells out to `claude -p`. Valid 1 year.
CLAUDE_CODE_OAUTH_TOKEN=

# --- YouTube Data API v3 (search) ---
# Enable in your Google Cloud project and restrict the key to this API.
# Used by src/zoro_youtube.py for search. Transcripts need no auth.
YOUTUBE_API_KEY=

# --- Web frontend ---------------------------------------------------------
# The Next.js app reads its own ./web/.env.local (NOT this file). It needs
# the LiveKit server creds plus the browser-exposed URL:
#   LIVEKIT_URL=
#   LIVEKIT_API_KEY=
#   LIVEKIT_API_SECRET=
#   NEXT_PUBLIC_LIVEKIT_URL=   # same wss URL, exposed to the browser
