{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Core capability for the Zoro shell window. Grants IPC access to the hosted Zoro web overlay.",
  "windows": ["main"],
  "remote": {
    "urls": [
      "https://*.azurecontainerapps.io/*",
      "https://*.azurecontainerapps.io",
      "https://*.vercel.app/*",
      "http://localhost:3000/*"
    ]
  },
  "permissions": ["core:default"]
}
