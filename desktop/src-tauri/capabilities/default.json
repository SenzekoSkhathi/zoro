{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Core capability for the Zoro shell window. Grants IPC and window control access to the hosted Zoro web overlay.",
  "windows": ["main"],
  "remote": {
    "urls": [
      "https://zoro-web.greentree-c12de99e.southafricanorth.azurecontainerapps.io/*",
      "https://zoro-web.greentree-c12de99e.southafricanorth.azurecontainerapps.io/*?*",
      "https://zoro-web.greentree-c12de99e.southafricanorth.azurecontainerapps.io?*",
      "https://zoro-web.greentree-c12de99e.southafricanorth.azurecontainerapps.io",
      "https://*.*.*.azurecontainerapps.io/*",
      "https://*.*.*.azurecontainerapps.io/*?*",
      "https://*.azurecontainerapps.io/*",
      "https://*.azurecontainerapps.io/*?*",
      "https://*.azurecontainerapps.io",
      "https://*.vercel.app/*",
      "https://*.vercel.app/*?*",
      "http://localhost:3000/*",
      "http://localhost:3000/*?*"
    ]
  },
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-set-always-on-top",
    "core:window:allow-is-always-on-top",
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:window:allow-unminimize",
    "core:window:allow-set-focus",
    "core:window:allow-set-size",
    "core:window:allow-set-position",
    "allow-start-drag",
    "allow-toggle-always-on-top",
    "allow-set-always-on-top",
    "allow-get-always-on-top",
    "allow-set-window-size",
    "allow-hide-window",
    "allow-set-overlay-mode",
    "allow-set-hit-regions",
    "core:window:allow-set-ignore-cursor-events"
  ]
}
